# CloudbitDEX (cloudbitex.com) - Production Environment Template
APP_ENV=production
DEFAULT_LOCALE=en
DEX_DOMAIN=https://cloudbitex.com

# CoinMarketCap Live Rate Proxy Configuration
CMC_API_KEY=your_coinmarketcap_pro_api_key_here
CMC_CACHE_TTL_SECONDS=60

# CloudbitDEX Fee & Treasury Configuration
ROUTER_FEE_BPS=25
LP_FEE_BPS=25
TREASURY_WALLET_EVM=0x_your_treasury_wallet_address_here
TOKEN_LISTING_FEE_BNB=0.5

# Primary CDBC Contract (BNB Smart Chain)
CDBC_BSC_CONTRACT=0xaf8b1b1bb4a47f537932968C7DE6E251dd50C6a9